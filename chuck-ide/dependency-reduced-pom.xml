<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>chuck-java-parent</artifactId>
    <groupId>org.chuck</groupId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>chuck-ide</artifactId>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>org.chuck.Launcher</mainClass>
                </transformer>
                <transformer />
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>org.chuck.ide.ChuckIDE</mainClass>
          <options>
            <option>--add-modules</option>
            <option>jdk.incubator.vector</option>
          </options>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>ide-bundle</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.2.0</version>
            <executions>
              <execution>
                <id>stage-jar-for-jpackage</id>
                <phase>package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <mkdir />
                    <copy />
                    <delete />
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>jpackage-ide</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/jpackage</executable>
                  <arguments>
                    <argument>--type</argument>
                    <argument>${jpackage.type}</argument>
                    <argument>--name</argument>
                    <argument>chuck-ide</argument>
                    <argument>--app-version</argument>
                    <argument>1.0.0</argument>
                    <argument>--input</argument>
                    <argument>${project.build.directory}/jpackage-input</argument>
                    <argument>--main-jar</argument>
                    <argument>chuck-java.jar</argument>
                    <argument>--main-class</argument>
                    <argument>org.chuck.Launcher</argument>
                    <argument>--java-options</argument>
                    <argument>--add-modules=jdk.incubator.vector</argument>
                    <argument>--dest</argument>
                    <argument>${project.build.directory}/chuck-ide-bundle</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <properties>
        <jpackage.type>app-image</jpackage.type>
      </properties>
    </profile>
  </profiles>
</project>
